# ============================================================================
# Plantão Pro — variáveis de ambiente
# ============================================================================
# Copie para `.env` e preencha com as credenciais reais do seu projeto Supabase.
# NUNCA commite o arquivo `.env` real (já está no .gitignore).

# ============================================================================
# Supabase (obrigatório)
# ============================================================================
# Obtidas em: https://supabase.com → seu-projeto → Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# ============================================================================
# Stripe (opcional — só quando ativar pagamentos)
# ============================================================================
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxx
# STRIPE_SECRET_KEY=sk_live_xxxxx        ← apenas no backend / Edge Functions
# STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# ============================================================================
# Mercado Pago (opcional — para pagamentos no Brasil)
# ============================================================================
# VITE_MERCADOPAGO_PUBLIC_KEY=APP_USR-xxxxx
# MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxx   ← apenas no backend

# ============================================================================
# Google Agendas (opcional — importar plantões do Google Calendar)
# ============================================================================
# Crie um OAuth Client ID (tipo "Web") no Google Cloud Console, habilite a
# "Google Calendar API" e adicione a origem autorizada (ex.: http://localhost:5173).
# Sem isto, a tela de integração funciona em modo demonstração.
# VITE_GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
